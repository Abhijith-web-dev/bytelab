  "title": "File Record to Class Object Pipeline Simulator",
  "description": "Step-by-step visual execution of reading structured text records ('students.txt'), parsing attributes, instantiating Student objects, invoking methods, and aggregating statistics.",
  "codeLines": [
    "class Student:",
    "    def __init__(self, name, mark):",
    "        self.name = name",
    "        self.mark = mark",
    "    def is_pass(self):",
    "        return self.mark >= 50",
    "records = ['Arun,85', 'Bala,42']",
    "students = []",
    "for line in records:",
    "    parts = line.strip().split(',')",
    "    obj = Student(parts[0], int(parts[1]))",
    "    students.append(obj)",
    "for s in students:",
    "    status = 'Pass' if s.is_pass() else 'Fail'",
    "    print(f'{s.name}: {s.mark} ({status})')"
  ],
