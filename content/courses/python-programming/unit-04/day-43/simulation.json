    "number = 6",
    "sq = number_tools.square(number)",
    "cb = number_tools.cube(number)",
    "ev = number_tools.is_even(number)",
    "print('Square =', sq)",
    "print('Cube =', cb)",
    "print('Even =', ev)"
  ],
